# The Prompt Pit — Challenge reference builds (SignalWire SDK). Copy to .env.
PORT=3400

# SignalWire — used to point a number at a challenge route.
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT=00000000-0000-0000-0000-000000000000
SIGNALWIRE_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Number to demo on (E.164); blank = skip auto number config.
CHALLENGE_NUMBER=+15555550123
# Which route the number points at: worst-ivr | fix-disaster | rogue-agent | carrier
CHALLENGE_ACTIVE=worst-ivr

# Basic auth for the SWML webhooks (auto-generated by run.sh if blank).
SWML_BASIC_AUTH_USER=pit
SWML_BASIC_AUTH_PASSWORD=change-me

# 0 = public quick-tunnel (reused for every challenge route). 1 = LAN only.
NO_TUNNEL=0
PUBLIC_URL=
TUNNEL_TOKEN=
