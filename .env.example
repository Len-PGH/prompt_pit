# The Prompt Pit — configuration template.
# Copy to `.env` and fill in.  `run.sh` creates one for you if it's missing.
#
#   cp .env.example .env
#
# NOTE: `.env` is git-ignored and is NOT baked into the Docker image; it is
# passed to the container at runtime via `docker run --env-file .env`.
# Never commit real values — everything below is a placeholder.

# ── Operator console ─────────────────────────────────────────────────────────
# Key for the /operator control panel. Anyone with it can drive the bracket,
# timers, scores and voting. Generate a random one:  openssl rand -hex 16
OPERATOR_KEY=change-me-before-the-show

# Port the server listens on inside the container (host maps to the same).
PORT=3000

# ── Public tunnel ────────────────────────────────────────────────────────────
# 1 = LAN-only, NO public cloudflared tunnel (offline / venue-WiFi demo).
# 0 = open a public quick-tunnel so phones/SMS/voice can reach the app.
NO_TUNNEL=0

# Optional: pin a STABLE public URL via a named Cloudflare tunnel (so the URL —
# and the SignalWire number config — survive restarts/reboots).
# 1) Create a tunnel in the Cloudflare Zero Trust dashboard, add a Public
#    Hostname mapped to Service http://localhost:3000, and copy its token.
# 2) Set both of these; leave blank to use the auto quick-tunnel.
PUBLIC_URL=            # e.g. https://pit.yourdomain.com
TUNNEL_TOKEN=          # the eyJ... token from the dashboard

# ── App ⇄ voice/SMS bridge ───────────────────────────────────────────────────
# Shared secret the SignalWire agent uses to post votes to the app's internal
# bridge, and the ?k= gate on the SMS webhook.  openssl rand -hex 12
INTERNAL_TOKEN=change-me

# ── SignalWire (phone + SMS voting) ──────────────────────────────────────────
# Leave these blank to run web-only (no phone/SMS). Fill them to auto-configure
# your number's Voice + Messaging handlers on startup.
# Your space, e.g. example.signalwire.com
SIGNALWIRE_SPACE=your-space.signalwire.com
# Project ID (UUID) from the SignalWire dashboard
SIGNALWIRE_PROJECT=00000000-0000-0000-0000-000000000000
# API token (Project token, starts with PT...). KEEP SECRET.
SIGNALWIRE_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The phone number that receives votes, E.164 format
VOTE_NUMBER=+15555550123

# Basic-auth password the app puts in the voice webhook URL so only SignalWire
# can invoke the agent. Auto-generated at startup if left blank.  openssl rand -hex 8
VOICE_AUTH_PASSWORD=change-me
